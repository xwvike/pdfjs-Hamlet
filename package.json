{
  "name": "pdfjs-hamlet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generic": "cd pdf.js-4.3.136 && gulp generic && cd ..",
    "copy-pdf": "copyfiles -u 1 './pdf.js-4.3.136/build/generic/*' './public/pdf.js/'",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prettier": "prettier --write ."
