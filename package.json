  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "endOfLine": "lf"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
